<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         CONFIGURACIÓN PRINCIPAL DE SPRING BOOT
         ===================================================== -->

    <parent>

        <groupId>org.springframework.boot</groupId>

        <artifactId>spring-boot-starter-parent</artifactId>

        <version>3.5.16</version>

        <relativePath/>

    </parent>


    <!-- =====================================================
         INFORMACIÓN DEL PROYECTO
         ===================================================== -->

    <groupId>com.sgcodramagdaortiz</groupId>

    <artifactId>sgcodramagdaortiz</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>sgcodramagdaortiz</name>

    <description>
        Sistema de Gestión de Citas Odontológicas
        Consultorio Dra. Magda Ortiz
    </description>


    <!-- =====================================================
         VERSIÓN DE JAVA
         ===================================================== -->

    <properties>

        <java.version>21</java.version>

    </properties>


    <!-- =====================================================
         DEPENDENCIAS
         ===================================================== -->

    <dependencies>


        <!-- =================================================
             SPRING DATA JPA
             Permite trabajar con MySQL mediante entidades
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-data-jpa</artifactId>

        </dependency>


        <!-- =================================================
             VALIDACIÓN
             Permite utilizar @Valid, @NotBlank, @Email, etc.
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-validation</artifactId>

        </dependency>


        <!-- =================================================
             SPRING WEB
             Permite crear APIs REST
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-web</artifactId>

        </dependency>


        <!-- =================================================
             SPRING SECURITY
             Permite implementar autenticación y autorización
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-security</artifactId>

        </dependency>


        <!-- =================================================
             JWT - API
             Define las interfaces utilizadas para trabajar
             con JSON Web Tokens
             ================================================= -->

        <dependency>

            <groupId>io.jsonwebtoken</groupId>

            <artifactId>jjwt-api</artifactId>

            <version>0.12.6</version>

        </dependency>


        <!-- =================================================
             JWT - IMPLEMENTACIÓN
             Contiene la implementación interna de JWT
             ================================================= -->

        <dependency>

            <groupId>io.jsonwebtoken</groupId>

            <artifactId>jjwt-impl</artifactId>

            <version>0.12.6</version>

            <scope>runtime</scope>

        </dependency>


        <!-- =================================================
             JWT - JACKSON
             Permite trabajar con JSON dentro de JWT
             ================================================= -->

        <dependency>

            <groupId>io.jsonwebtoken</groupId>

            <artifactId>jjwt-jackson</artifactId>

            <version>0.12.6</version>

            <scope>runtime</scope>

        </dependency>


        <!-- =================================================
             MYSQL
             Driver para conectarse a MySQL
             ================================================= -->

        <dependency>

            <groupId>com.mysql</groupId>

            <artifactId>mysql-connector-j</artifactId>

            <scope>runtime</scope>

        </dependency>


        <!-- =================================================
             DEVTOOLS
             Facilita el desarrollo y reinicio automático
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-devtools</artifactId>

            <scope>runtime</scope>

            <optional>true</optional>

        </dependency>


        <!-- =================================================
             TEST
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-test</artifactId>

            <scope>test</scope>

        </dependency>


    </dependencies>


    <!-- =====================================================
         CONFIGURACIÓN DE MAVEN
         ===================================================== -->

    <build>

        <plugins>

            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>

        </plugins>

    </build>


</project>